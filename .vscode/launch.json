{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Playwright Tests",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "playwright",
                "test"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
                "NODE_ENV": "test"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Current Test",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "playwright",
                "test",
                "${relativeFile}"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}